{
  "robot_name": "Nexus-7",
  "version": "1.0.0",
  "hardware": {
    "servo_serial_port": "/dev/ttyS2",
    "servo_baudrate": 1000000,
    "spi_bus": 1,
    "spi_device": 0,
    "i2c_bus": 3,
    "imu_address": "0x68"
  },
  "servos": {
