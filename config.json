    "neck_tilt_id": 2,
    "left_shoulder_pitch_id": 3,
    "left_shoulder_roll_id": 4,
    "left_elbow_id": 5,
    "left_gripper_id": 6,
    "right_shoulder_pitch_id": 7,
    "right_shoulder_roll_id": 8,
    "right_elbow_id": 9,
    "right_gripper_id": 10
  },
  "motor_driver": {
    "left_rpwm": 35,
    "left_lpwm": 36,
    "right_rpwm": 37,
    "right_lpwm": 38
  },
  "llm": {
    "model_name": "tinyllama:1.1b",
